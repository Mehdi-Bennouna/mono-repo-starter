	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/lint-staged-config": "workspace:*",
		"@repo/logger": "workspace:*",
		"@repo/tsdown-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}

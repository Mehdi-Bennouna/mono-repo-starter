{
	"name": "@repo/public-api",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"format": "prettier --write .",
		"lint": "eslint .",
		"start": "sops exec-env env/${ENV_FILE:-dev.env} 'node dist/index.mjs'",
		"typecheck": "tsc --noEmit"
